# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# PortOne V2 — 포트원 콘솔 > 연동 정보에서 발급
# 심사 캡처용으로는 테스트 채널의 값을 넣으세요.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# 포트원 콘솔 > 웹훅에서 발급. 웹훅 서명 검증에 사용되며 절대 공개 금지.
PORTONE_WEBHOOK_SECRET=

# 포트원 콘솔 > 결제 연동 > API Secret. 빌링키 삭제·카드정보 조회에 사용. 공개 금지.
PORTONE_API_SECRET=

# 출시 전 서비스(sniff-hospital, csv-automation, fem-ai) 메뉴 노출 여부.
# 'true'일 때만 네비바·푸터에 표시되고, 미설정이면 숨김이 기본값이다.
# KCP 카드사 심사 중에는 "사이트 100% 완성" 항목 때문에 숨겨둔다.
# 라우트는 살아 있으므로 URL 직접 접근은 값과 무관하게 항상 가능하다.
NEXT_PUBLIC_SHOW_UPCOMING_SERVICES=
